---
import { Image } from "astro:assets";
import heroImage from "../assets/images/Seoul-Image-900-900.png";
---

<div class="hero-section full-width set-site-max-width margin-inline-auto">
    <div class="text-side">
        <h1 class="">Astro Starter Template</h1>
        <p>
            A template built by Bryan Hogan for performant high-quality
            websites.
        </p>
        <p>The easiest way to make your next website.</p>
        <div class="hero-buttons">
            <a href="/about">Get started</a>
            <a href="/blog">Learn more</a>
        </div>
    </div>
    <div class="image-side">
        <Image src={heroImage} alt="Hero image alt text. Describe the image." />
    </div>
</div>

<style>
    .hero-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: var(--space-l);
        min-height: 70svh;
        h1 {
            margin-bottom: var(--space-m);
        }
        p {
            margin-bottom: var(--space-s);
        }
    }
    .image-side {
        order: -1;
        flex: 1;
        min-height: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        img {
            width: auto;
            max-width: 24rem;
            max-height: 100%;
            border-radius: var(--border-radius-m);
        }
    }
    @media (min-width: 48rem) {
        .hero-section {
            flex-direction: row;
            align-items: center;
            justify-content: center;
            gap: var(--space-xl);
            width: auto;
        }
        .text-side {
        }
        .image-side {
            order: 0;
            width: auto;
            align-items: center;
        }
    }
</style>
