---
interface Props {
    headingId?: string;
    class?: string;
}

const {
    headingId = "hero-title",
    class: className,
} = Astro.props;
---

<section
    class:list={[
        "hero-section",
        "full-width",
        "set-site-max-width",
        "margin-inline-auto",
        className,
    ]}
    aria-labelledby={headingId}
>
    <div class="hero-content">
        <slot name="eyebrow" />

        <h1 id={headingId}>
            <slot name="heading" />
        </h1>

        <p class="hero-description">
            <slot name="description" />
        </p>

        <div class="hero-buttons">
            <slot name="actions" />
        </div>
    </div>

    <div class="hero-media">
        <slot name="media" />
    </div>
</section>

<style>
    .hero-section {
        --hero-columns: minmax(0, 1fr);
        --hero-section-gap: var(--space-l);
        --hero-content-alignment: center;
        --hero-content-max-width: var(--content-max-width);
        --hero-actions-direction: column;
        --hero-actions-justification: center;
        --hero-action-width: 100%;
        --hero-media-max-width: 24rem;

        display: grid;
        grid-template-columns: var(--hero-columns);
        align-items: center;
        justify-content: center;
        gap: var(--hero-section-gap);
        min-height: 70svh;
        padding-block: var(--space-l);
    }

    .hero-content {
        width: 100%;
        max-width: var(--hero-content-max-width);
        margin-inline: auto;
        text-align: var(--hero-content-alignment);
    }

    .hero-content > h1 {
        margin: 0 0 var(--space-m);
    }

    .hero-description {
        color: var(--color-text-subtle);
        font-size: var(--font-size-l);
    }

    .hero-buttons {
        display: flex;
        flex-direction: var(--hero-actions-direction);
        flex-wrap: wrap;
        justify-content: var(--hero-actions-justification);
        align-items: center;
        gap: var(--space-s);
        margin-top: var(--space-m);
    }

    .hero-buttons :global(.button) {
        width: var(--hero-action-width);
    }

    .hero-media {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-width: 0;
    }

    .hero-media :global(img) {
        width: auto;
        max-width: min(var(--hero-media-max-width), 100%);
        max-height: 100%;
        border-radius: var(--border-radius-m);
    }

    @media (min-width: 48rem) {
        .hero-section {
            --hero-section-gap: var(--space-xl);
            --hero-actions-direction: row;
            --hero-action-width: auto;
            --hero-media-max-width: 32rem;
        }
    }

    @media (min-width: 64rem) {
        .hero-section {
            --hero-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
            --hero-content-alignment: start;
            --hero-content-max-width: 36rem;
            --hero-actions-justification: flex-start;
            --hero-media-max-width: 30rem;
        }

        .hero-content {
            margin-inline: 0;
        }
    }
</style>
