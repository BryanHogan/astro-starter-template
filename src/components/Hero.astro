---
import type { HTMLAttributes } from "astro/types";

type Props = Omit<
    HTMLAttributes<"section">,
    "aria-labelledby" | "class:list"
> & {
    heading: string;
    headingHighlight?: string;
    headingId: string;
    eyebrow?: string;
    description?: string;
};

const {
    heading,
    headingHighlight,
    headingId,
    eyebrow,
    description,
    class: className,
    ...rest
} = Astro.props;

const hasActions = Astro.slots.has("actions");
const hasMedia = Astro.slots.has("media");
---

<section
    {...rest}
    class:list={[
        "hero-section",
        "full-width",
        "set-site-max-width",
        "margin-inline-auto",
        { "has-media": hasMedia },
        className,
    ]}
    aria-labelledby={headingId}
>
    <div class="hero-content">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}

        <h1 id={headingId}>{heading}{headingHighlight && " "}{headingHighlight && <span class="hero-heading-highlight">{headingHighlight}</span>}</h1>

        {description && <p class="hero-description">{description}</p>}

        {
            hasActions && (
                <div class="hero-actions">
                    <slot name="actions" />
                </div>
            )
        }
    </div>

    {
        hasMedia && (
            <div class="hero-media">
                <slot name="media" />
            </div>
        )
    }
</section>

<style>
    .hero-section {
        --hero-columns: minmax(0, 1fr);
        --hero-section-gap: var(--space-l);
        --hero-content-alignment: center;
        --hero-content-max-width: var(--content-max-width);
        --hero-actions-direction: column;
        --hero-actions-justification: center;
        --hero-action-width: 100%;
        --hero-media-max-width: 24rem;

        display: grid;
        grid-template-columns: var(--hero-columns);
        align-items: center;
        gap: var(--hero-section-gap);
        min-height: var(--hero-min-height, 70svh);
        padding-block: var(--space-l);
    }

    .hero-content {
        width: 100%;
        max-width: var(--hero-content-max-width);
        margin-inline: auto;
        text-align: var(--hero-content-alignment);
    }

    .hero-content > h1 {
        margin: 0 0 var(--space-m);
    }

    .hero-heading-highlight {
        color: var(--hero-highlight-color, var(--color-accent-200));
    }

    .hero-description {
        color: var(--color-text-subtle);
        font-size: var(--font-size-l);
    }

    .hero-actions {
        display: flex;
        flex-direction: var(--hero-actions-direction);
        flex-wrap: wrap;
        justify-content: var(--hero-actions-justification);
        align-items: center;
        gap: var(--space-s);
        margin-top: var(--space-m);
    }

    .hero-actions :global(.button) {
        width: var(--hero-action-width);
    }

    .hero-media {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-width: 0;
    }

    .hero-media :global(img) {
        width: auto;
        height: auto;
        max-width: min(var(--hero-media-max-width), 100%);
        border-radius: var(--border-radius-m);
    }

    @media (min-width: 48rem) {
        .hero-section {
            --hero-section-gap: var(--space-xl);
            --hero-actions-direction: row;
            --hero-action-width: auto;
            --hero-media-max-width: 32rem;
        }
    }

    @media (min-width: 64rem) {
        .hero-section.has-media {
            --hero-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
            --hero-content-alignment: start;
            --hero-content-max-width: 36rem;
            --hero-actions-justification: flex-start;
            --hero-media-max-width: 30rem;

            max-width: min(
                var(
                    --hero-layout-max-width,
                    calc(
                        var(--hero-content-max-width) +
                            var(--hero-media-max-width) +
                            var(--hero-section-gap)
                    )
                ),
                calc(100% - (var(--side-gap-padding) * 2))
            );
        }

        .hero-section.has-media .hero-content {
            margin-inline: 0;
        }
    }
</style>
