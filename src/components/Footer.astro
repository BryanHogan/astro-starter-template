---
import Icon from "./Icon.astro";
import { SITE } from "../config";

// Social icons are optional; the local RSS feed is always available.
const iconLinks = ([
    { name: "instagram", label: "Instagram", url: SITE.social.instagram, external: true, type: undefined },
    { name: "threads", label: "Threads", url: SITE.social.threads, external: true, type: undefined },
    { name: "mastodon", label: "Mastodon", url: SITE.social.mastodon, external: true, type: undefined },
    { name: "rss", label: "Subscribe via RSS", url: "/rss.xml", external: false, type: "application/rss+xml" },
] as const).filter((link) => link.url);
---

<footer class="set-site-max-width">
    <div class="flex-center flex-column">
        <p class="text-align-center">A website by {SITE.author}.</p><p class="text-align-center">
            © {SITE.startYear} - {new Date().getFullYear()}
        </p>
    </div>
    {iconLinks.length > 0 && (
        <ul role="list" class="flex-center">
            {iconLinks.map((link) => (
                <li>
                    <a
                        href={link.url}
                        type={link.type}
                        target={link.external ? "_blank" : undefined}
                        rel={link.external ? "noopener noreferrer" : undefined}
                    >
                        <span class="visually-hidden">
                            {link.label}{link.external && " (opens in a new tab)"}
                        </span>
                        <Icon name={link.name} size="1.5rem" />
                    </a>
                </li>
            ))}
        </ul>
    )}
    <ul role="list" class="flex-center navigation-container">
        <li><p><a href="/">Home</a></p></li>
        <li><p><a href="/about">About</a></p></li>
        <li><p><a href="/about#contact">Contact</a></p></li>
        <li><p><a href="/sitemap-index.xml">Sitemap</a></p></li>
    </ul>
</footer>

<style>
    footer {
        display: grid;
        grid-template-columns: 1fr;
        min-height: var(--footer-height);
        align-items: center;
        margin-inline: auto;
        border-top: 1px solid var(--color-border);
        >* {
            height: max-content;
            margin-block: var(--space-s);
        }
    }
    ul {
        gap: var(--space-s);
    }
    .navigation-container {
        max-width: 75%;
        margin-inline: auto;
    }
    p, li, img, a {
        color: var(--color-text-muted);
        transition: color var(--transition-normal);
    }
    a:hover, a:focus-within {
        color: var(--color-link-hover);
    }
    a:active {
        color: var(--color-link-active);
    }

    @media only screen and (min-width: 48rem) {
        footer {
            grid-template-columns: 1fr 1fr 1fr;
        }
    }
</style>
