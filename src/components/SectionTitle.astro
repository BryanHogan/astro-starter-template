---
type HeadingLevel = "h1" | "h2" | "h3" | "h4" | "h5" | "h6";

interface Props {
    eyebrow: string;
    title: string;
    as: HeadingLevel;
    /** Override the generated ID when preserving an anchor or repeating a title. */
    id?: string;
    class?: string;
}

const {
    eyebrow,
    title,
    as: Heading,
    id,
    class: className,
} = Astro.props;

if (typeof eyebrow !== "string" || !eyebrow.trim()) {
    throw new Error("SectionTitle requires a non-empty `eyebrow` prop.");
}

if (typeof title !== "string" || !title.trim()) {
    throw new Error("SectionTitle requires a non-empty `title` prop.");
}

const eyebrowText = eyebrow.trim();
const titleText = title.trim();

const createHeadingId = (value: string) =>
    value
        .normalize("NFKC")
        .toLowerCase()
        .replace(/[^\p{L}\p{N}]+/gu, "-")
        .replace(/^-+|-+$/g, "");

const headingId = id ?? createHeadingId(titleText);

if (!headingId) {
    throw new Error(
        "SectionTitle could not generate an ID from `title`; provide an explicit `id` prop.",
    );
}

if (/\s/u.test(headingId)) {
    throw new Error("SectionTitle `id` must not contain whitespace.");
}
---

<Heading id={headingId} class:list={["section-title", className]}>
    <span class="eyebrow">{eyebrowText}</span>{" "}
    <span class="section-title__text">{titleText}</span>
</Heading>

<style>
    .section-title > span {
        display: block;
    }
</style>
