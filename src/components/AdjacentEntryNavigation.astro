---
import type { EntryNavigationItem } from "../types/entry";

interface Props {
    previousEntry?: EntryNavigationItem;
    nextEntry?: EntryNavigationItem;
}

const { previousEntry, nextEntry } = Astro.props;
---

{
    (previousEntry || nextEntry) && (
        <nav class="entry-navigation" aria-label="Previous and next pages">
            {previousEntry && (
                <a
                    class="entry-navigation-link entry-navigation-previous"
                    href={previousEntry.href}
                    rel="prev"
                >
                    <span class="entry-navigation-label">Previous</span>
                    <span class="entry-navigation-title">
                        {previousEntry.title}
                    </span>
                </a>
            )}

            {nextEntry && (
                <a
                    class="entry-navigation-link entry-navigation-next"
                    href={nextEntry.href}
                    rel="next"
                >
                    <span class="entry-navigation-label">Next</span>
                    <span class="entry-navigation-title">{nextEntry.title}</span>
                </a>
            )}
        </nav>
    )
}

<style>
    .entry-navigation {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        width: 100%;
        overflow: hidden;
        background-color: var(--color-surface);
        border: var(--border-width-s) solid var(--color-border);
        border-radius: var(--border-radius-m);
        box-shadow: var(--box-shadow-s);
    }

    .entry-navigation-link {
        display: flex;
        justify-content: flex-start;
        flex-direction: column;
        gap: var(--space-s);
        min-width: 0;
        padding: var(--space-m);
        color: var(--color-text-strong);
        text-decoration: none;
        transition: background-color var(--transition-normal);
    }

    @media (hover: hover) {
        .entry-navigation-link:hover {
            color: var(--color-text-strong);
            background-color: var(--color-surface-muted);
        }
    }

    .entry-navigation-link:focus-visible {
        color: var(--color-text-strong);
        background-color: var(--color-surface-muted);
        outline-offset: -3px;
    }

    .entry-navigation-link + .entry-navigation-link {
        border-block-start: var(--border-width-s) solid var(--color-border);
    }

    .entry-navigation-next {
        text-align: end;
    }

    .entry-navigation-label {
        color: var(--color-accent-text);
        font-size: var(--font-size-s);
        font-weight: var(--font-weight-semi-bold);
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .entry-navigation-title {
        overflow-wrap: anywhere;
        color: var(--color-text-strong);
        font-size: var(--font-size-l);
        font-weight: var(--font-weight-regular);
        line-height: var(--font-line-height-heading);
        text-decoration: underline;
        text-underline-offset: 0.15em;
        text-wrap: balance;
    }

    @media (min-width: 48rem) {
        .entry-navigation {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .entry-navigation-link {
            padding: var(--space-l);
        }

        .entry-navigation-link:only-child {
            grid-column: 1 / -1;
        }

        .entry-navigation-link + .entry-navigation-link {
            border-block-start: 0;
            border-inline-start: var(--border-width-s) solid var(--color-border);
        }
    }
</style>
