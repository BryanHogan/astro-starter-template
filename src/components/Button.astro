---
import Icon from "./Icon.astro";
import type { IconName } from "./Icons";

interface Props {
    /** Link mode: renders an <a> with this href. Omit for action mode: renders a <button>. */
    href?: string;
    /** Disabled links keep their accessible role and tab stop, but omit href. */
    disabled?: boolean;
    /** Action mode only. */
    type?: "button" | "submit" | "reset";
    variant?: "primary" | "secondary" | "outline" | "ghost" | "danger";
    /** Explicit sizes use intrinsic width. Omit to allow the parent layout to stretch the button. */
    size?: "small" | "medium" | "large";
    iconLeft?: IconName;
    iconRight?: IconName;
    class?: string;
    [key: string]: any;
}

const {
    href,
    disabled = false,
    "aria-disabled": ariaDisabled,
    type = "button",
    variant = "primary",
    size,
    iconLeft,
    iconRight,
    class: className,
    ...rest
} = Astro.props;

const Tag = href ? "a" : "button";
const isDisabled = disabled || ariaDisabled === true || ariaDisabled === "true";
// This distinction is intentional: an omitted size may stretch with its parent layout,
// while an explicit size opts into an intrinsic-width button.
const visualSize = size ?? "medium";
---

<Tag
    {...rest}
    class:list={[
        "button",
        variant,
        visualSize,
        { "explicit-size": size !== undefined },
        className,
    ]}
    href={isDisabled ? undefined : href}
    type={href ? undefined : type}
    disabled={!href && isDisabled ? true : undefined}
    aria-disabled={isDisabled ? "true" : ariaDisabled}
    role={href && isDisabled ? "link" : rest.role}
    tabindex={href && isDisabled ? (rest.tabindex ?? 0) : rest.tabindex}
>
    {iconLeft && <Icon name={iconLeft} size="1em" />}
    <slot />
    {iconRight && <Icon name={iconRight} size="1em" />}
</Tag>

<style>
    .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: var(--border-width-s) solid transparent;
        border-radius: var(--border-radius-m);
        font-weight: var(--font-weight-semi-bold);
        line-height: 1;
        text-decoration: none;
        cursor: pointer;
        background-color: transparent;
        transition:
            var(--transition-normal) background-color,
            var(--transition-normal) color,
            var(--transition-normal) border-color;
        &:disabled,
        &[aria-disabled="true"] {
            opacity: var(--opacity-strong);
            cursor: not-allowed;
        }
    }

    .explicit-size {
        inline-size: fit-content;
        max-inline-size: 100%;
    }

    .small {
        padding: var(--space-2xs) var(--space-s);
        font-size: var(--font-size-s);
        gap: var(--space-2xs);
        font-weight: var(--font-weight-regular);
    }
    .medium {
        padding: var(--space-xs) var(--space-m);
        font-size: var(--font-size-base);
        gap: var(--space-xs);
    }
    .large {
        padding: var(--space-s) var(--space-l);
        font-size: var(--font-size-base);
        gap: var(--space-xs);
    }

    /* Keep variant colors above prose link styles, including when disabled. */
    .button.primary {
        background-color: var(--color-accent-300);
        color: var(--color-black);
        &:not(:disabled, [aria-disabled="true"]):is(:hover, :focus-within) {
            background-color: var(--color-accent-200);
            color: var(--color-black);
        }
        &:not(:disabled, [aria-disabled="true"]):active {
            background-color: var(--color-accent-100);
            color: var(--color-black);
        }
    }
    .button.secondary {
        background-color: var(--color-surface);
        color: var(--color-text-strong);
        &:not(:disabled, [aria-disabled="true"]):is(:hover, :focus-within) {
            background-color: var(--color-surface-muted);
            color: var(--color-text-strong);
        }
        &:not(:disabled, [aria-disabled="true"]):active {
            color: var(--color-text-strong);
        }
    }
    .button.outline {
        border-color: var(--color-border);
        color: var(--color-text-strong);
        &:not(:disabled, [aria-disabled="true"]):is(:hover, :focus-within) {
            border-color: var(--color-accent-300);
            background-color: var(--color-surface);
            color: var(--color-text-strong);
        }
        &:not(:disabled, [aria-disabled="true"]):active {
            color: var(--color-text-strong);
        }
    }
    .button.ghost {
        color: var(--color-text-strong);
        &:not(:disabled, [aria-disabled="true"]):is(:hover, :focus-within) {
            background-color: var(--color-surface);
            color: var(--color-text-strong);
        }
        &:not(:disabled, [aria-disabled="true"]):active {
            color: var(--color-text-strong);
        }
    }
    .button.danger {
        background-color: var(--color-red-600);
        color: var(--color-white);
        &:not(:disabled, [aria-disabled="true"]):is(:hover, :focus-within) {
            background-color: var(--color-red-500);
            color: var(--color-white);
        }
        &:not(:disabled, [aria-disabled="true"]):active {
            background-color: var(--color-red-400);
            color: var(--color-white);
        }
    }
</style>
