---
import BaseLayout from "./BaseLayout.astro";
import Button from "../components/Button.astro";
import { Content as AuthorBio } from "../content/author.md";
import "../styles/markdown.css";
import { SITE } from "../config";

interface Props {
    title: string;
    description: string;
    pubDate: Date;
}

const { title, description, pubDate } = Astro.props;

const formattedPubDate = new Intl.DateTimeFormat(SITE.locale, {
    dateStyle: "long",
    timeZone: "UTC",
}).format(pubDate);
---

<BaseLayout
    title={title}
    description={description}
    ogType="article"
    articlePublished={pubDate}
>
    <main class="base-layout base-layout-content height-smart-fill-screen">
        <article class="blog-post">
            <header class="blog-post-header main-header-element">
                <nav class="blog-post-navigation" aria-label="Blog navigation">
                    <Button
                        href="/blog"
                        variant="outline"
                        size="small"
                        iconLeft="left-arrow"
                    >
                        Back to blog
                    </Button>
                </nav>
                <time
                    class="blog-post-date"
                    datetime={pubDate.toISOString().slice(0, 10)}
                >
                    {formattedPubDate}
                </time>
                <h1>{title}</h1>
            </header>

            <div class="blog-post-body markdown-container">
                <slot />
            </div>

            <section class="blog-post-author markdown-container">
                <AuthorBio />
            </section>
        </article>
    </main>
</BaseLayout>

<style>
    .blog-post {
        min-width: 0;
        padding-block-end: var(--space-2xl);
    }

    .blog-post-header {
        display: grid;
        gap: var(--space-s);
    }

    .blog-post-navigation {
        margin-block-end: var(--space-m);
    }

    .blog-post-date {
        color: var(--color-text-muted);
        font-size: var(--font-size-s);
    }

    .blog-post-header h1 {
        overflow-wrap: anywhere;
        text-wrap: balance;
    }

    .blog-post-body {
        margin-block-start: var(--space-xl);
    }

    .blog-post-author {
        padding-block-start: var(--space-l);
        margin-block-start: var(--space-2xl);
        border-block-start: var(--border-width-s) solid var(--color-border);
    }
</style>
