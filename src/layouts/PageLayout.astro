---
import BaseLayout from "./BaseLayout.astro";
import "../styles/markdown.css";


interface Props {
    title: string;
    description: string;
    topSpacing?: boolean;
    canonical?: string;
    ogTitle?: string;
    ogDescription?: string;
    ogImage?: string;
    ogImageAlt?: string;
    ogType?: "website" | "article";
    articlePublished?: Date;
    articleModified?: Date;
    articleTags?: string[];
    robots?: string;
    author?: string;
}

const { frontmatter, ...rest } = Astro.props as Props & { frontmatter?: Props };
const props = { ...frontmatter, ...rest };
const { topSpacing = true, ...baseLayoutProps } = props;
const hasTopSpacing = topSpacing !== false;
---

<BaseLayout {...baseLayoutProps}>
    <slot name="head" slot="head" />
    <main
        id="main-content"
        tabindex="-1"
        class:list={[
            "base-layout base-layout-content markdown-container height-smart-fill-screen padding-bottom-2xl",
            { "padding-top-xl": hasTopSpacing },
        ]}
    >
        <slot />
    </main>
</BaseLayout>
