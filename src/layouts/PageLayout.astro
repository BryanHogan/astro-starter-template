---
import BaseLayout from "./BaseLayout.astro";
import "../styles/markdown.css";


interface Props {
    title: string;
    description: string;
    canonical?: string;
    ogTitle?: string;
    ogDescription?: string;
    ogImage?: string;
    ogImageAlt?: string;
    ogType?: "website" | "article";
    articlePublished?: Date;
    articleModified?: Date;
    articleTags?: string[];
    robots?: string;
    author?: string;
}

const { frontmatter, ...rest } = Astro.props as Props & { frontmatter?: Props };
const props = { ...frontmatter, ...rest };
---

<BaseLayout {...props}>
    <slot name="head" slot="head" />
    <main
        class="base-layout base-layout-content markdown-container height-smart-fill-screen"
    >
        <slot />
    </main>
</BaseLayout>
