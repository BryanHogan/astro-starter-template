---
import type { GetStaticPaths } from "astro";
import { render, type CollectionEntry } from "astro:content";
import EntryLayout from "../../layouts/EntryLayout.astro";
import type { EntryNavigationItem } from "../../types/entry";
import { getEntries } from "../../utils/getEntries";

interface Props {
    post: CollectionEntry<"blog">;
    previousEntry?: EntryNavigationItem;
    nextEntry?: EntryNavigationItem;
}

export const getStaticPaths = (async () => {
    const posts = await getEntries("blog");

    const toNavigationItem = (
        post: CollectionEntry<"blog">,
    ): EntryNavigationItem => ({
        title: post.data.title,
        href: `/blog/${post.id}`,
    });

    return posts.map((post, index) => ({
        params: { id: post.id },
        props: {
            post,
            previousEntry:
                index > 0 ? toNavigationItem(posts[index - 1]) : undefined,
            nextEntry:
                index < posts.length - 1
                    ? toNavigationItem(posts[index + 1])
                    : undefined,
        },
    }));
}) satisfies GetStaticPaths;

const { post, previousEntry, nextEntry } = Astro.props;
const { Content } = await render(post);
const ogImage = `/og/blog/${post.id}.png`;
---

<EntryLayout
    {...post.data}
    {ogImage}
    backLink={{ href: "/blog", label: "Back to blog" }}
    {previousEntry}
    {nextEntry}
>
    <Content />
</EntryLayout>
